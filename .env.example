# ─────────────────────────────────────────────────────────────
# Job Agent — environment configuration
#
# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — never commit it.
# ─────────────────────────────────────────────────────────────

# ── LLM (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ── Telegram (daily brief + quick actions) ──────────────────
TELEGRAM_BOT_TOKEN=123456789:REPLACE_ME
TELEGRAM_CHAT_ID=123456789

# ── LinkedIn (via the Apify "LinkedIn Jobs Scraper" actor) ──
APIFY_TOKEN=apify_replace_me

# ── Y Combinator "Work at a Startup" login ──────────────────
YC_EMAIL=you@example.com
YC_PASSWORD=your-yc-password

# ── PostgreSQL ──────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jobagent
POSTGRES_USER=jobagent
POSTGRES_PASSWORD=change-me

# ── Scheduling (daily scout run, UTC) ───────────────────────
DAILY_RUN_HOUR=7
DAILY_RUN_MINUTE=0

# ── Search preferences ──────────────────────────────────────
SEARCH_REMOTE_ONLY=true
SEARCH_LOCATIONS=United States,Canada,Remote
SEARCH_EXCLUDE_KEYWORDS=crypto,blockchain,web3,nft,solidity,rust,go,golang,kafka,kubernetes,devops
SEARCH_MUST_HAVE=typescript,next.js,react,python,node.js,aws
SEARCH_ROLE_TITLES=Founding Engineer,Founding Full-Stack,Full-Stack Engineer,Product Engineer,Founding Software Engineer
SEARCH_MIN_SALARY=120000
SEARCH_MIN_SCORE=70

# ── API server ──────────────────────────────────────────────
API_PORT=3000
